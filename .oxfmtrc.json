{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": { "sortScripts": true },
  "ignorePatterns": [
    ".claude",
    ".next",
    ".swc",
    "dist",
    "build",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "tsconfig.tsbuildinfo"
  ],
  "sortImports": true
}
