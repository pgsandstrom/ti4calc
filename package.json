{
  "name": "ti4-calc",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build --no-cache",
    "docker-up": "docker compose up -d",
    "format": "prettier --write \"{,!(.next|dist|node_modules)/**/}!(package-lock).{json,md,js,jsx,ts,tsx,css,scss}\"",
    "lint": "eslint --max-warnings 0 \"**/*.{ts,tsx,js}\"",
    "pre-commit": "lint-staged",
    "pre-push": "npm run lint && npm run test && npm run typecheck",
    "start": "next start -p 3000",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/lodash": "4.17.23",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.13",
    "husky": "9.1.7",
    "lodash": "4.17.23",
    "next": "16.1.6",
    "pg": "8.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "tsx": "4.21.0",
    "@next/eslint-plugin-next": "16.1.6",
    "eslint": "9.39.2",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "sass": "1.97.3",
    "typescript-eslint": "8.55.0"
  },
  "lint-staged": {
    "*.{js,json,md,css,scss,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  }
}
