{
  "name": "ti4-calc",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build",
    "docker-up": "docker compose up -d",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate && pnpm run format:check",
    "prepare": "husky",
    "release": "node scripts/docker-release.mjs",
    "start": "next start -p 3000",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@types/lodash": "4.17.24",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.15",
    "husky": "9.1.7",
    "lodash": "4.18.1",
    "next": "16.2.6",
    "pg": "8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "lint-staged": "17.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "sass": "1.99.0",
    "tsx": "4.22.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.15.0"
}
