{
  "name": "ti4-calc",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build",
    "docker-up": "docker compose up -d",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check .",
    "lint": "eslint --max-warnings 0 \"**/*.{ts,tsx,js}\"",
    "pre-commit": "lint-staged",
    "pre-push": "npm run validate && npm run format:check",
    "start": "next start -p 3000",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/lodash": "4.17.24",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.15",
    "husky": "9.1.7",
    "lodash": "4.18.1",
    "next": "16.2.6",
    "pg": "8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "tsx": "4.22.3",
    "@next/eslint-plugin-next": "16.1.6",
    "eslint": "9.39.2",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "typescript-eslint": "8.59.4"
  },
  "lint-staged": {
    "*.{js,json,md,css,scss,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  }
}
